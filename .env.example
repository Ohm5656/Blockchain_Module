# Fuji TESTNET ONLY. Copy to .env.local (ignored by git).
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Official Circle Test USDC; other token contracts are rejected.
FUJI_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# Dedicated TEST-ONLY Wallet A. Never use NEXT_PUBLIC_ or a mainnet wallet key.
FUJI_SIGNER_PRIVATE_KEY=
# Dedicated TEST-ONLY Wallet B; must differ from Wallet A.
FUJI_DESTINATION_ADDRESS=
# Positive integer base units, NOT a decimal USDC amount. 1000 = 0.001 USDC.
FUJI_SMOKE_TEST_USDC_UNITS=1000

# Task 2: server-only Postgres URI from Supabase Connect (direct/session/transaction pooler).
# Use a test project. Runtime login must inherit fuji_settlement_service.
SUPABASE_DB_URL=
# Optional PEM CA certificate if your Supabase TLS certificate needs a custom CA.
# TLS verification is always enabled for non-loopback hosts.
SUPABASE_DB_CA_CERT=
# Required for settlement smoke, Task 3 verification and Task 4 recovery; keep the SAME ID for the same logical transfer.
# Never generate a new ID just because an earlier result was uncertain.
# Verification/recovery read expected values from DB; only PREPARING recovery may need the test signer key.
FUJI_SETTLEMENT_TRANSFER_ID=

# Task 5 one-shot runner. Conservative defaults are 10 records and 60 seconds.
# Both are server-only; batch size is capped at 50 and cooldown at 24 hours.
FUJI_RUNNER_BATCH_SIZE=10
FUJI_RUNNER_COOLDOWN_MS=60000
